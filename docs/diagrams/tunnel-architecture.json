  "cards": [
    {
      "dot": "emerald",
      "title": "The bus",
      "items": [
        "One WebSocket carries tagged envelopes, each with a stream_id",
        "gRPC and HTTP are two independent users of it; the bus knows neither",
        "Payloads chunk at 64 KiB so one large message cannot block the others"
      ]
    },
    {
      "dot": "violet",
      "title": "Why it works through NAT",
      "items": [
        "The agent opens the connection; the hub never connects inward",
        "No inbound listener and no port forwarding on the private machine",
        "On a drop the agent reconnects with backoff; calls in flight end as UNAVAILABLE"
      ]
    },
    {
      "dot": "cyan",
      "title": "Schema-free relay",
      "items": [
        "The hub accepts any method via UnknownServiceHandler",
        "A passthrough codec reports its name as \"proto\", so payload bytes are never touched",
        "Neither hub nor agent imports the tunnelled service's schema"
      ]
    },
    {
      "dot": "rose",
      "title": "Security posture",
      "items": [
        "The agent's Bearer token is checked before the WebSocket upgrade",
        "Callers are not authenticated: both hub listeners bind to 127.0.0.1 by default",
        "The link is ws:// by default — TLS is required before the hub leaves localhost"
      ]
    }
  ]
}
